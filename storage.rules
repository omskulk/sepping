rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Proof photos live under pings/{pingId}/proof.
    // Any signed-in user can read (so actives see their assigned PNM's submissions).
    // Only signed-in users can upload; further scoping to "assigned PNM only" requires a
    // Firestore lookup which Storage rules don't have directly — punt to Cloud Functions
    // if this becomes an abuse vector.
    match /pings/{pingId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
